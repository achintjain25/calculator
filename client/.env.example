# =============================================================================
# RJ Jewellers — client build configuration
#
# Copy to `.env` only if you need to override the default:
#     copy .env.example .env
#
# WARNING: everything here is compiled into the JavaScript bundle and is
# readable by anyone who opens the site. Never put a password, API key or
# database credential in this file.
# =============================================================================

# Absolute base URL of the backend API.
#
# Leave this UNSET for the standard deployment, where the Express server serves
# both this bundle and the API from one origin — the relative "/api" default
# then works in development (via the Vite proxy) and in production alike.
#
# Set it only for a split deployment, with the client on a static host and the
# API on another domain. Remember to add that host to CORS_ORIGIN in
# server/.env.
#
# VITE_API_BASE_URL=https://api.rjjewellers.example.com/api
