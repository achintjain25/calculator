{
  "name": "jewelry-shop-server",
  "version": "1.0.0",
  "private": true,
  "description": "RJ Jewellers backend API",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node-dev --transpile-only src/migrate.ts",
    "migrate:status": "ts-node-dev --transpile-only src/migrate.ts status",
    "migrate:prod": "node dist/migrate.js",
    "reconcile": "ts-node-dev --transpile-only src/reconcile.ts",
    "reconcile:prod": "node dist/reconcile.js",
    "set-password": "ts-node-dev --transpile-only src/setPassword.ts",
    "set-password:prod": "node dist/setPassword.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
