# =============================================================================
# RJ Jewellers — server configuration
#
# Copy this file to `.env` and fill in the real values:
#     copy .env.example .env
#
# `.env` is git-ignored and must NEVER be committed — it holds the database
# password. If a real password has ever been committed, rotate it.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rj_jewellers
DB_USER=postgres
DB_PASSWORD=

# A managed provider (Neon, Supabase, RDS…) usually gives one connection
# string instead. When set, it overrides the five DB_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/rj_jewellers

# Most managed providers require TLS; a local install does not.
DB_SSL=false
# Set to false only for a server with a self-signed certificate.
DB_SSL_REJECT_UNAUTHORIZED=true

# Max simultaneous database connections held by this process.
DB_POOL_MAX=10

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# `production` enables the strict CSP, hides internal error details from API
# responses, silences per-request logging, and serves the built client.
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Only needed when the client is served from a DIFFERENT origin than this API.
# In the standard production setup this server serves client/dist itself, so
# requests are same-origin and this value is unused.
# Comma-separated for multiple origins.
CORS_ORIGIN=http://localhost:5173

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# Set to true ONLY when running behind nginx / IIS / Cloudflare, so the real
# client IP is read from X-Forwarded-For. Leaving it true on a directly-exposed
# server lets anyone spoof their IP and bypass rate limiting.
TRUST_PROXY=false

# ── Rate limiting (per IP, per minute) ────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITES_PER_MINUTE=60

# ── Timezone ──────────────────────────────────────────────────────────────────
# Determines when "today" rolls over for payment and bill dates. Without this,
# a server running in UTC records the previous day's date until 05:30 IST.
TZ=Asia/Kolkata

# Business timezone used for "today" on payments, bills and dashboards.
APP_TIMEZONE=Asia/Kolkata

# ── Authentication (single shop user) ─────────────────────────────────────────
# The shop has one operator, so credentials live here rather than in a users
# table. The session is a signed, stateless cookie.
#
# Generate the hash and secret with:
#     npm run set-password -- "your password here"
# then paste the printed lines below.

# Auth is ON unless this is explicitly "false", so a misconfigured deployment
# fails closed instead of silently serving customer data to anyone.
# Set to false ONLY for local development on a machine nobody else can reach.
AUTH_ENABLED=true

AUTH_USERNAME=owner

# scrypt hash of the password. Never store the password itself here.
AUTH_PASSWORD_HASH=

# Signs the session cookie. Keep it stable — changing it signs you out.
# Required in production; the server refuses to start without it.
AUTH_SESSION_SECRET=

# How long a login lasts before it must be repeated.
AUTH_SESSION_HOURS=12

# Failed sign-in attempts allowed per IP per 15 minutes.
AUTH_LOGIN_ATTEMPTS_PER_15MIN=10

# Send the session cookie only over HTTPS. Leave unset to auto-decide:
# on when NODE_ENV=production and TRUST_PROXY=true, off otherwise.
# Setting this true while serving plain HTTP makes login silently fail,
# because the browser will refuse to store the cookie.
# AUTH_COOKIE_SECURE=true

# Plaintext alternative to AUTH_PASSWORD_HASH. Works, but stores the password
# in this file in the clear — prefer the hash.
# AUTH_PASSWORD=
